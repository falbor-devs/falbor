{
  "manifest_version": 3,
  "name": "Falbor Automation",
  "version": "1.0.0",
  "description": "Assists with posting approved Reddit comments from Falbor. The user reviews and submits every comment manually.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "*://*.reddit.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "automation@falbor.app",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Falbor Automation",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
