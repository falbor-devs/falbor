# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT models
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Used for importing/cloning repositories and accessing private repos
# NOTE: Use NEXT_PUBLIC_ prefix so it's available in the browser
NEXT_PUBLIC_GITHUB_ACCESS_TOKEN=your_github_access_token_here
NEXT_PUBLIC_GITHUB_TOKEN_TYPE=classic

# Supabase Project Configuration
# Get your project details from: https://supabase.com/dashboard
# Select your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Access Token (for management operations)
# Generate from: https://supabase.com/dashboard/account/tokens
NEXT_PUBLIC_SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here
NEXT_PUBLIC_SUPABASE_ORG_ID=your_supabase_org_id_here

# Neon Database Connection String (used by Falbor's OWN database, not the chat websites)
# Get from: https://console.neon.tech -> your project -> Connection Details
DATABASE_URL=your_neon_database_url_here

# NEON_API_KEY — REQUIRED. Every website created in a chat auto-provisions a new
# Neon project using this key. Create one at:
#   https://console.neon.tech/app/settings/api-keys
# (Profile icon bottom-left -> "API Keys" -> "Create new API key", then copy the key)
NEON_API_KEY=your_neon_api_key_here

# NEON_ORG_ID — OPTIONAL. If your API key belongs to a personal account and you want
# projects created inside a specific Neon organization, add the org ID here.
# Find it at: https://console.neon.tech -> click your org -> the URL shows /org-xxxx...
# If you use an organization API key, this can stay empty (org is inferred from the key).
NEON_ORG_ID=your_neon_org_id_here

# JWT Secret for Session Tokens (generate a random string)
JWT_SECRET=your_random_jwt_secret_here

NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# SETUP INSTRUCTIONS
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in the API keys for the services you want to use
# 3. All service integration keys use NEXT_PUBLIC_ prefix for auto-connection
# 4. Restart your development server: pnpm run dev
# 5. Services will auto-connect on startup if tokens are provided
# 6. Go to Settings > Service tabs to manage connections manually if needed

# Google login
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ======================================
# MCP INTEGRATIONS (OAUTH CREDENTIALS)
# ======================================
# As the site owner, you need to provide the OAuth Client IDs and Secrets
# for integrations where users simply click "Connect Account".
# For API-based integrations (Twilio, Firecrawl, etc.), users will enter their own keys in the UI.

# Stripe OAuth App
# Get these from your Stripe Dashboard > Settings > Connect > Settings
# IMPORTANT: You must add BOTH of these Redirect URIs in your Stripe Dashboard!
STRIPE_CLIENT_ID=your_stripe_client_id_here
STRIPE_CLIENT_SECRET=your_stripe_client_secret_here
STRIPE_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/stripe/callback
STRIPE_REDIRECT_URI_PROD=https://falbor.xyz/api/auth/stripe/callback

# Gmail / Google Workspace OAuth
# Get these from Google Cloud Console > APIs & Services > Credentials
# IMPORTANT: You must add BOTH of these Redirect URIs in your Google Cloud Console!
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/gmail/callback
GMAIL_REDIRECT_URI_PROD=https://falbor.xyz/api/auth/gmail/callback

# Slack OAuth App
# Get these from https://api.slack.com/apps > Your App > Basic Information
# IMPORTANT: You must add BOTH of these Redirect URIs in your Slack Dashboard!
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/slack/callback
SLACK_REDIRECT_URI_PROD=https://falbor.xyz/api/auth/slack/callback

# Discord OAuth App
# Get these from https://discord.com/developers/applications
# IMPORTANT: You must add BOTH of these Redirect URIs in your Discord OAuth2 settings!
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/discord/callback
DISCORD_REDIRECT_URI_PROD=https://falbor.xyz/api/auth/discord/callback

# Miro Integration
MIRO_CLIENT_ID=your_miro_client_id_here
MIRO_CLIENT_SECRET=your_miro_client_secret_here
MIRO_REDIRECT_URI_LOCAL=http://localhost:3000/api/auth/miro/callback
MIRO_REDIRECT_URI_PROD=https://falbor.xyz/api/auth/miro/callback

# Additional AI Models and Integrations
QWEN_API_KEY=your_qwen_api_key_here
BROWSERBASE_API_KEY=your_browserbase_api_key_here
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# Stayup Configuration
NEXT_PUBLIC_STAYUP_PROJECT_ID=your_stayup_project_id_here
NEXT_PUBLIC_STAYUP_API_KEY=your_stayup_api_key_here

# Stripe Payment
STRIPE_SECRET_KEY=your_stripe_secret_key_here
